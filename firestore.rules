rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function allowedUser() {
      return signedIn() && request.auth.token.email == "jerry83145@gmail.com";
    }

    function isOwner() {
      return allowedUser() && request.auth.uid == resource.data.userId;
    }

    function createsOwnRecord() {
      return allowedUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdBy == request.auth.token.email;
    }

    match /accountingUploads/{uploadId} {
      allow create: if createsOwnRecord();
      allow read, update: if isOwner();
      allow delete: if false;
    }

    match /ledgerRecords/{recordId} {
      allow create: if createsOwnRecord();
      allow read, update: if isOwner();
      allow delete: if isOwner();
    }

    match /inventoryRecords/{recordId} {
      allow create: if createsOwnRecord();
      allow read, update: if isOwner();
      allow delete: if isOwner();
    }

    match /assetRecords/{recordId} {
      allow create: if createsOwnRecord();
      allow read, update: if isOwner();
      allow delete: if isOwner();
    }

    match /bankTransactions/{recordId} {
      allow create: if createsOwnRecord();
      allow read, update: if isOwner();
      allow delete: if isOwner();
    }
  }
}
